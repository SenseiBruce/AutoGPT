# Root env template. Copy the platform file for a working local stack:
#   cp autogpt_platform/.env.example autogpt_platform/.env
#   cp autogpt_platform/backend/.env.example autogpt_platform/backend/.env
#   cp autogpt_platform/frontend/.env.example autogpt_platform/frontend/.env
#
# Common variables referenced by backend/util/settings.py:

DATABASE_URL=postgresql://postgres:REPLACE_ME@localhost:5432/postgres?schema=platform
DIRECT_URL=postgresql://postgres:REPLACE_ME@localhost:5432/postgres?schema=platform
REDIS_HOST=localhost
REDIS_PORT=6379
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
ENCRYPTION_KEY=
JWT_VERIFY_KEY=
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_BASE_URL=http://localhost:3000
PLATFORM_BASE_URL=http://localhost:8000
RABBITMQ_DEFAULT_USER=rabbitmq_user_default
RABBITMQ_DEFAULT_PASS=REPLACE_ME
SENTRY_DSN=
LAUNCH_DARKLY_SDK_KEY=
STRIPE_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
POSTGRES_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME
ANON_KEY=REPLACE_ME
SERVICE_ROLE_KEY=REPLACE_ME
